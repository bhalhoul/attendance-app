{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-newsroom.local/schemas/story.schema.json",
  "title": "Story",
  "description": "One news event, built from one or more raw items. Carries its verification record and its full status history from intake to archive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "neutral_summary", "desk", "countries", "status", "breaking",
               "original_source", "supporting_sources", "event_time", "verification",
               "importance", "raw_item_ids", "history", "created_at", "updated_at"],
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "published_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "owner": {"type": ["string", "null"], "description": "Owning group, to tell independent outlets from sister titles."},
        "independent": {"type": ["boolean", "null"], "description": "False when it repeats another source (same owner, wire copy, or cites it). Null = not yet judged."},
        "cites": {"type": ["string", "null"], "description": "Source this outlet says it is quoting, if any."}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^st_[0-9]{8}_[0-9a-f]{8}$"},
    "title": {"type": "string", "minLength": 1},
    "neutral_summary": {"type": "string", "description": "Facts only, no adjectives or opinion. Empty until the desk writes it."},
    "desk": {"enum": ["morocco", "spain_ceuta", "world", "sports", "economy"]},
    "countries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
    "topics": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["intake", "clustered", "verifying", "verified", "disputed", "false",
                        "selected", "scripted", "produced", "qc_passed", "approved_by_editor",
                        "published", "archived", "rejected"]},
    "breaking": {"type": "boolean", "description": "If true, every output must say the information is preliminary and may change."},
    "original_source": {"$ref": "#/$defs/source_ref"},
    "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
    "event_time": {"type": ["string", "null"], "format": "date-time", "description": "When the event happened (UTC), if known. Distinct from publication time."},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "checked_at", "evidence", "unconfirmed", "statements_vs_facts"],
      "properties": {
        "level": {"enum": ["confirmed", "under_review", "disputed", "false"],
                  "description": "confirmed = مؤكد, under_review = قيد التحقق, disputed = متنازع عليه, false = غير صحيح"},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "independent_source_count": {"type": "integer", "minimum": 0},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "unconfirmed": {"type": "array", "items": {"type": "string"}, "description": "Claims in the story that are not yet confirmed."},
        "statements_vs_facts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["text", "kind"],
          "properties": {"text": {"type": "string"}, "kind": {"enum": ["fact", "statement", "estimate"]}, "attributed_to": {"type": ["string", "null"]}}
        }},
        "recycled_check": {"type": ["string", "null"], "description": "How we checked this is not an old story republished."},
        "checked_by": {"type": ["string", "null"]}
      }
    },
    "importance": {"type": "object", "additionalProperties": false, "required": ["score", "reasons"],
      "properties": {"score": {"type": "number", "minimum": 0, "maximum": 100}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "raw_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^raw_[0-9a-f]{16}$"}},
    "history": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["at", "status", "by"],
      "properties": {"at": {"type": "string", "format": "date-time"}, "status": {"type": "string"}, "by": {"type": "string"}, "note": {"type": "string"}}
    }},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
