{"text":"في أنطاليا، رفضت الجلسة الختامية لقمة المناخ كوب واحد وثلاثين مشروع الاتفاق المعروف باسم ميثاق أنطاليا. الخلاف الأكبر كان حول الوقود الأحفوري، إذ رفض الاتحاد الأوروبي أي نص لا يذكره، كما تحفظت دول أخرى بينها بنما وجزر مارشال. ولم تتفق الدول أيضا على هدف محدد لمضاعفة تمويل التكيف ثلاث مرات. لكن بعض القرارات التقنية نجت، مثل آلية الانتقال العادل. الأمين العام للأمم المتحدة أنطونيو غوتيريش قال إنه يشعر بخيبة أمل عميقة، فيما يبقى اتفاق باريس ساريا.","chars":["ف","ي"," ","أ","ن","ط","ا","ل","ي","ا","،"," ","ر","ف","ض","ت"," ","ا","ل","ج","ل","س","ة"," ","ا","ل","خ","ت","ا","م","ي","ة"," ","ل","ق","م","ة"," ","ا","ل","م","ن","ا","خ"," ","ك","و","ب"," ","و","ا","ح","د"," ","و","ث","ل","ا","ث","ي","ن"," ","م","ش","ر","و","ع"," ","ا","ل","ا","ت","ف","ا","ق"," ","ا","ل","م","ع","ر","و","ف"," ","ب","ا","س","م"," ","م","ي","ث","ا","ق"," ","أ","ن","ط","ا","ل","ي","ا","."," ","ا","ل","خ","ل","ا","ف"," ","ا","ل","أ","ك","ب","ر"," ","ك","ا","ن"," ","ح","و","ل"," ","ا","ل","و","ق","و","د"," ","ا","ل","أ","ح","ف","و","ر","ي","،"," ","إ","ذ"," ","ر","ف","ض"," ","ا","ل","ا","ت","ح","ا","د"," ","ا","ل","أ","و","ر","و","ب","ي"," ","أ","ي"," ","ن","ص"," ","ل","ا"," ","ي","ذ","ك","ر","ه","،"," ","ك","م","ا"," ","ت","ح","ف","ظ","ت"," ","د","و","ل"," ","أ","خ","ر","ى"," ","ب","ي","ن","ه","ا"," ","ب","ن","م","ا"," ","و","ج","ز","ر"," ","م","ا","ر","ش","ا","ل","."," ","و","ل","م"," ","ت","ت","ف","ق"," ","ا","ل","د","و","ل"," ","أ","ي","ض","ا"," ","ع","ل","ى"," ","ه","د","ف"," ","م","ح","د","د"," ","ل","م","ض","ا","ع","ف","ة"," ","ت","م","و","ي","ل"," ","ا","ل","ت","ك","ي","ف"," ","ث","ل","ا","ث"," ","م","ر","ا","ت","."," ","ل","ك","ن"," ","ب","ع","ض"," ","ا","ل","ق","ر","ا","ر","ا","ت"," ","ا","ل","ت","ق","ن","ي","ة"," ","ن","ج","ت","،"," ","م","ث","ل"," ","آ","ل","ي","ة"," ","ا","ل","ا","ن","ت","ق","ا","ل"," ","ا","ل","ع","ا","د","ل","."," ","ا","ل","أ","م","ي","ن"," ","ا","ل","ع","ا","م"," ","ل","ل","أ","م","م"," ","ا","ل","م","ت","ح","د","ة"," ","أ","ن","ط","و","ن","ي","و"," ","غ",